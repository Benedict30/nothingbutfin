# Caddy: HTTPS for your domain (certificates obtained and renewed automatically),
# in front of the app container on 127.0.0.1:3000. Copy to deploy/Caddyfile and fill in.
{
	email you@example.com
}

example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

# everything else goes to the main address
www.example.com {
	redir https://example.com{uri} permanent
}
