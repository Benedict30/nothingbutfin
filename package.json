{
  "name": "financial-statements-viewer",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Income statement, balance sheet and cash flow history from SEC EDGAR",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/normalize.test.js && node test/magazine.test.js && node test/preliminary.test.js && node test/reminders.test.js",
    "check:data": "node test/check-data.js",
    "mock": "node test/mock-sec.js"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
